<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.vynzyx.vencord-reinject</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>{{SCRIPT}}</string>
    </array>

    <!-- Fire when Discord's per-user data dir changes. A Discord update stages a
         new app-<ver> folder here with a fresh, vanilla desktop_core module, so
         this catches updates within seconds. This is a HOME-folder path, so it
         works with SIP enabled and never touches the signed .app bundle. -->
    <key>WatchPaths</key>
    <array>
        <string>{{WATCHDIR}}</string>
    </array>

    <!-- Backstops in case a watch event is missed. -->
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>3600</integer>

    <!-- Coalesce rapid changes into at most one run per 10s. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardErrorPath</key>
    <string>{{ERRLOG}}</string>
</dict>
</plist>
